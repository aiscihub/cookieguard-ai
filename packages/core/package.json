  "homepage": "https://github.com/aiscihub/cookieguard-ai/tree/main/packages/core",
  "bugs": "https://github.com/aiscihub/cookieguard-ai/issues",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org" },
  "engines": { "node": ">=24" },
  "exports": {
    ".": { "types": "./src/index.d.ts", "import": "./src/index.js" },
    "./onnx": { "types": "./src/onnx.d.ts", "import": "./src/onnx.js" }
  },
  "files": ["src", "vendor", "LICENSE", "README.md"],
  "peerDependencies": { "onnxruntime-node": "1.30.0" },
  "peerDependenciesMeta": { "onnxruntime-node": { "optional": true } },
  "repository": { "type": "git", "url": "git+https://github.com/aiscihub/cookieguard-ai.git", "directory": "packages/core" }

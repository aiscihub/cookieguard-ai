{
  "$id": "https://raw.githubusercontent.com/aiscihub/cookieguard-ai/main/schemas/mcp-audit-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "incomplete"
      ]
    },
    "exitCode": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cookieId": {
            "type": "string"
          },
          "cookieName": {
            "type": [
              "string",
              "null"
            ]
          },
          "ruleId": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "review"
            ],
            "description": "confirmed: observed policy violation; review: heuristic or uncertain, never fails"
          },
          "title": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "evidenceSource": {
            "description": "header = server Set-Cookie declaration; browser = cookie-store observation; probe = session replay; storage = Web Storage entry",
            "type": "string",
            "enum": [
              "header",
              "browser",
              "fixture",
              "legacy",
              "probe",
              "storage"
            ]
          },
          "identityBasis": {
            "description": "Why the cookie is treated as authentication: developer evidence or uncalibrated heuristics",
            "type": "string",
            "enum": [
              "developer-name",
              "validated-auth-flow",
              "extension-rule-heuristic",
              "extension-onnx-uncalibrated"
            ]
          }
        },
        "required": [
          "cookieId",
          "cookieName",
          "ruleId",
          "severity",
          "status",
          "title",
          "why",
          "fix"
        ],
        "additionalProperties": false
      }
    },
    "omittedFindings": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "provenance": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "http-scan",
                "evidence-file"
              ]
            },
            "producer": {
              "type": "string",
              "enum": [
                "cookieguard-http-scan",
                "cookieguard-report",
                "cookieguard-browser-use"
              ]
            },
            "observedByServer": {
              "type": "boolean",
              "description": "false when the evidence was collected elsewhere and supplied as a file"
            }
          },
          "required": [
            "source",
            "producer",
            "observedByServer"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "exitCode",
    "target",
    "summary",
    "issues",
    "limitations",
    "findings",
    "omittedFindings",
    "error"
  ],
  "additionalProperties": false
}
